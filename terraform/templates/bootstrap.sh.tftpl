#!/usr/bin/env bash
set -euo pipefail

MODE="${mode}"
PROJECT_PREFIX_PARAM="${project_prefix_param}"
WORKSPACE_PARAM="${workspace_param}"
BUCKET_PARAM="${bucket_param}"
UBUNTU_PASSWORD_HASH_PARAM="${ubuntu_password_hash_param}"
DEV_STATE_ENABLED="${dev_state_enabled}"
DEV_STATE_MOUNT_PATH="${dev_state_mount_path}"
DEV_STATE_VOLUME_ID_PARAM="${dev_state_volume_id_param}"

LOG_FILE="/var/log/robotics-bootstrap.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "[$(date -Is)] bootstrap start mode=$${MODE}"

# small helper to retry the execution with set sleep times in between
retry() {
  local n=0
  local max="$${1:-20}"
  local sleep_sec="$${2:-10}"
  shift 2
  if [ "$#" -eq 0 ]; then
    echo "retry requires a command to execute"
    return 1
  fi
  until "$@"; do
    n=$((n+1))
    if [ "$n" -ge "$max" ]; then
      echo "Command failed after $${max} retries: $*"
      return 1
    fi
    sleep "$sleep_sec"
  done
}

get_param() {
  local name="$1"
  aws ssm get-parameter --name "$name" --query 'Parameter.Value' --output text
}

get_secure_param() {
  local name="$1"
  aws ssm get-parameter --name "$name" --with-decryption --query 'Parameter.Value' --output text
}

configure_ubuntu_password() {
  local password_hash
  password_hash="$(get_secure_param "$UBUNTU_PASSWORD_HASH_PARAM")"
  usermod --password "$password_hash" ubuntu
}

mount_dev_state_volume() {
  local mount_point="$DEV_STATE_MOUNT_PATH"
  local device=""
  local volume_id=""
  local uuid=""

  volume_id="$(get_param "$DEV_STATE_VOLUME_ID_PARAM" 2>/dev/null || true)"
  if [ -n "$volume_id" ]; then
    local by_id="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$(echo "$volume_id" | tr -d '-')"
    if [ -L "$by_id" ]; then
      device="$(readlink -f "$by_id")"
    fi
  fi

  if [ ! -b "$device" ] && [ -b "/dev/sdg" ]; then
    device="/dev/sdg"
  fi

  if [ ! -b "$device" ]; then
    echo "Dev state volume device not found. volume_id=$volume_id"
    return 1
  fi

  echo "Using dev state volume device: $device"
  mkdir -p "$mount_point"
  if ! blkid "$device" >/dev/null 2>&1; then
    mkfs -t ext4 "$device"
  fi

  uuid="$(blkid -s UUID -o value "$device" || true)"
  if [ -z "$uuid" ]; then
    echo "Unable to determine filesystem UUID for device: $device"
    return 1
  fi

  awk -v mp="$mount_point" '$2 != mp { print $0 }' /etc/fstab > /etc/fstab.tmp
  mv /etc/fstab.tmp /etc/fstab
  echo "UUID=$uuid $mount_point ext4 defaults,nofail 0 2" >> /etc/fstab
  mountpoint -q "$mount_point" || mount "$mount_point"
}

configure_dev_state() {
  local mount_point="$DEV_STATE_MOUNT_PATH"

  mkdir -p \
    "$mount_point/ws" \
    "$mount_point/docker" \
    "$mount_point/.cache/uv" \
    "$mount_point/.cache/rattler" \
    "$mount_point/.local/share"
  chown -R ubuntu:ubuntu "$mount_point"

  # Workspace convenience symlink
  if [ ! -d "/home/ubuntu/ws" ] || [ -L "/home/ubuntu/ws" ]; then
    ln -sfn "$mount_point/ws" /home/ubuntu/ws
    chown -h ubuntu:ubuntu /home/ubuntu/ws
  fi

  # Move Docker data from root volume to dev-state on fresh volumes
  systemctl stop docker.socket docker
  if [ -d /var/lib/docker ] && [ ! -d "$mount_point/docker/image" ]; then
    echo "Migrating Docker data to dev-state volume..."
    rsync -a /var/lib/docker/ "$mount_point/docker/" 2>/dev/null || true
  fi

  # Update Docker data-root
  local docker_config="/etc/docker/daemon.json"
  local docker_root="$mount_point/docker"
  if [ -f "$docker_config" ]; then
    python3 -c "
import json, sys
with open('$docker_config') as f:
    cfg = json.load(f)
cfg['data-root'] = '$docker_root'
with open('$docker_config', 'w') as f:
    json.dump(cfg, f, indent=2)
"
  else
    echo "{\"data-root\": \"$docker_root\"}" > "$docker_config"
  fi
  systemctl start docker

  # Shell environment for dev-state paths
  cat > /etc/profile.d/dev-state.sh <<PROFILE
export XDG_CACHE_HOME="$mount_point/.cache"
export XDG_DATA_HOME="$mount_point/.local/share"
export UV_CACHE_DIR="$mount_point/.cache/uv"
export PIXI_CACHE_DIR="$mount_point/.cache/rattler"
export RATTLER_CACHE_DIR="$mount_point/.cache/rattler"
PROFILE

  # Snapshot helper
  cat > /usr/local/bin/snapshot-dev-state <<'SNAPSCRIPT'
#!/usr/bin/env bash
set -euo pipefail

MOUNT_PATH="$${1:-/work}"

if ! mountpoint -q "$MOUNT_PATH"; then
  echo "Error: $MOUNT_PATH is not mounted" >&2
  exit 1
fi

DEVICE="$(findmnt -no SOURCE "$MOUNT_PATH")"
VOLUME_ID=""
for link in /dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_vol*; do
  [ -L "$link" ] || continue
  if [ "$(readlink -f "$link")" = "$DEVICE" ]; then
    raw="$${link##*_}"
    VOLUME_ID="$${raw:0:3}-$${raw:3}"
    break
  fi
done

if [ -z "$VOLUME_ID" ]; then
  echo "Error: could not determine volume ID from $DEVICE" >&2
  exit 1
fi

echo "Stopping Docker..."
systemctl stop docker.socket docker

echo "Syncing filesystem..."
sync

echo "Creating snapshot of $VOLUME_ID..."
SNAPSHOT_ID="$(aws ec2 create-snapshot \
  --volume-id "$VOLUME_ID" \
  --description "dev-state $(date -Is)" \
  --tag-specifications "ResourceType=snapshot,Tags=[{Key=Name,Value=dev-state-snapshot},{Key=Source,Value=$VOLUME_ID}]" \
  --query 'SnapshotId' --output text)"

echo "Waiting for $SNAPSHOT_ID to complete..."
aws ec2 wait snapshot-completed --snapshot-ids "$SNAPSHOT_ID"

echo "Starting Docker..."
systemctl start docker

echo "$SNAPSHOT_ID"
SNAPSCRIPT
  chmod +x /usr/local/bin/snapshot-dev-state
}

mkdir -p /mnt/assets /mnt/isaac

configure_ubuntu_password

BUCKET="$(get_param "$BUCKET_PARAM")"
PROJECT_PREFIX="$(get_param "$PROJECT_PREFIX_PARAM")"
WORKSPACE_PATH="$(get_param "$WORKSPACE_PARAM")"

configure_project_sync_aliases() {
cat >> /home/ubuntu/.bashrc <<BASHRC
_s3_sync_args() {
  local exclude_file="$${WORKSPACE_PATH}/.s3ignore"
  local args=()
  if [[ -f "\$exclude_file" ]]; then
    while IFS= read -r pattern; do
      [[ -z "\$pattern" || "\$pattern" == \#* ]] && continue
      args+=(--exclude "\$pattern")
    done < "\$exclude_file"
  fi
  printf '%s\0' "\$${args[@]}"
}

alias s3-pull='mapfile -d "" _args < <(_s3_sync_args) && aws s3 sync "s3://$${BUCKET}/$${PROJECT_PREFIX}" "$${WORKSPACE_PATH}" --delete "\$${_args[@]}"'
alias s3-push='mapfile -d "" _args < <(_s3_sync_args) && aws s3 sync "$${WORKSPACE_PATH}" "s3://$${BUCKET}/$${PROJECT_PREFIX}" --delete "\$${_args[@]}"'
BASHRC
}

configure_project_sync_aliases

if [ "$DEV_STATE_ENABLED" = "true" ]; then
  if retry 30 10 mount_dev_state_volume; then
    configure_dev_state
  else
    logger -t robotics "Dev state volume mount failed; skipping dev state configuration"
  fi
fi

mkdir -p "$WORKSPACE_PATH"
chown ubuntu:ubuntu "$WORKSPACE_PATH"
retry 12 10 aws s3 sync "s3://$${BUCKET}/$${PROJECT_PREFIX}" "$WORKSPACE_PATH" --delete
chown -R ubuntu:ubuntu "$WORKSPACE_PATH"

mount_isaac_volume() {
  local preferred_device="$${1:-/dev/sdf}"
  local mount_point="$${2:-/mnt/isaac}"
  local device=""
  local root_source=""
  local root_disk=""
  local uuid=""

  if [ -b "$preferred_device" ]; then
    device="$preferred_device"
  else
    root_source="$(findmnt -no SOURCE / || true)"
    if [ -n "$root_source" ]; then
      root_disk="$(lsblk -no PKNAME "$root_source" 2>/dev/null || true)"
      if [ -z "$root_disk" ]; then
        root_disk="$(basename "$root_source")"
      fi
    fi

    # Nitro instances expose EBS as NVMe devices. Select the first non-root EBS disk.
    device="$(lsblk -dn -P -o NAME,TYPE,MODEL | awk -v root="$root_disk" '
      {
        name = ""; type = ""; model = "";
        if (match($0, /NAME="[^"]+"/)) {
          name = substr($0, RSTART + 6, RLENGTH - 7);
        }
        if (match($0, /TYPE="[^"]+"/)) {
          type = substr($0, RSTART + 6, RLENGTH - 7);
        }
        if (match($0, /MODEL="[^"]+"/)) {
          model = substr($0, RSTART + 7, RLENGTH - 8);
        }
        if (type == "disk" && model == "Amazon Elastic Block Store" && name != root) {
          print "/dev/" name;
          exit;
        }
      }
    ')"
  fi

  if [ ! -b "$device" ]; then
    echo "Isaac volume device not found. preferred=$preferred_device root=$root_disk resolved=$device"
    return 1
  fi

  echo "Using Isaac volume device: $device"
  mkdir -p "$mount_point"
  # create an ext4 filesystem in case EBS volume is blank (no isaac_snapshot_id provided)
  if ! blkid "$device" >/dev/null 2>&1; then
    mkfs -t ext4 "$device"
  fi

  uuid="$(blkid -s UUID -o value "$device" || true)"
  if [ -z "$uuid" ]; then
    echo "Unable to determine filesystem UUID for device: $device"
    return 1
  fi

  awk -v mp="$mount_point" '$2 != mp { print $0 }' /etc/fstab > /etc/fstab.tmp
  mv /etc/fstab.tmp /etc/fstab
  echo "UUID=$uuid $mount_point ext4 defaults,nofail 0 2" >> /etc/fstab
  mountpoint -q "$mount_point" || mount "$mount_point"
}

ensure_bind_mount() {
  local source_dir="$1"
  local target_dir="$2"
  local owner="$${3:-}"
  local fstab_line="$${source_dir} $${target_dir} none bind,nofail 0 0"

  mkdir -p "$source_dir" "$target_dir"
  if [ -n "$owner" ]; then
    chown "$owner:$owner" "$source_dir" "$target_dir" || true
  fi

  if ! grep -Fqs "$fstab_line" /etc/fstab; then
    echo "$fstab_line" >> /etc/fstab
  fi
  mountpoint -q "$target_dir" || mount "$target_dir"
}

configure_isaac_bind_mounts() {
  local persist_root="/mnt/isaac/persist"
  ensure_bind_mount "$${persist_root}/home-ubuntu/.cache/ov" "/home/ubuntu/.cache/ov" "ubuntu"
  ensure_bind_mount "$${persist_root}/home-ubuntu/.nv/ComputeCache" "/home/ubuntu/.nv/ComputeCache" "ubuntu"
  ensure_bind_mount "$${persist_root}/home-ubuntu/.nvidia-omniverse/logs" "/home/ubuntu/.nvidia-omniverse/logs" "ubuntu"
  ensure_bind_mount "$${persist_root}/home-ubuntu/.nvidia-omniverse/config" "/home/ubuntu/.nvidia-omniverse/config" "ubuntu"
  ensure_bind_mount "$${persist_root}/home-ubuntu/.local/share/ov/data" "/home/ubuntu/.local/share/ov/data" "ubuntu"
  ensure_bind_mount "$${persist_root}/home-ubuntu/.local/share/ov/pkg" "/home/ubuntu/.local/share/ov/pkg" "ubuntu"
}

if [ "$MODE" = "isaac" ]; then
  if retry 30 10 mount_isaac_volume /dev/sdf /mnt/isaac; then
    configure_isaac_bind_mounts
  else
    logger -t robotics "Isaac volume mount did not succeed; skipping bind mounts"
  fi
fi

echo "[$(date -Is)] bootstrap done"
