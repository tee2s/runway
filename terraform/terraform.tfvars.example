region               = "us-east-1"
project_name         = "robotics-dev"
parameter_prefix     = "/robotics-dev"
# S3 bucket name is auto-derived as: <project_name>-<account_id>-<region>.
vpc_cidr             = "10.42.0.0/16"
# Your public IP /32 (or office CIDR). Required — 0.0.0.0/0 is rejected. See terraform/README.md for Isaac streaming security.
trusted_client_cidr  = "76.36.228.147/32" 
gazebo_launch_template_instance_types = ["g6f.xlarge", "g6f.2xlarge", "g4dn.xlarge", "g4dn.2xlarge"]
isaac_launch_template_instance_types  = ["g6e.2xlarge", "g6.2xlarge", "g5.2xlarge"]
root_volume_size_gib = 120
base_ami_id          = "ami-0e510af39d1780e35"
# Optional: set snap-... to restore Isaac data, or leave empty for a fresh volume.
isaac_snapshot_id    = "snap-0dd030ad9fd06f6ac"
# Used only when isaac_snapshot_id is empty.
isaac_data_volume_size_gib = 80
# the path in s3 under which the project data will be loaded from
s3_project_prefix    = "ws/"
# where in the instance the project data should be loaded too
workspace_path       = "/home/ubuntu/ws"
# SSM SecureString created by scripts/create-ubuntu-password.sh.
ubuntu_password_hash_parameter_name = "/ubuntu-default-password-hash"
# Optional existing EC2 key pair name for SSH access.
# Leave null to use SSM Session Manager only.
runtime_key_pair_name = "tmac"
# Local private key path used to update ssh profile ~/.ssh/config.d/<project_name>.
runtime_private_key_path = "~/.ssh/tmac.pem"
runtime_enabled      = false
simulation_mode      = "gazebo"

# Dev-state volume: persists Docker images, caches, and workspace across sessions via snapshots.
# Snapshot ID is managed automatically in SSM — no manual tfvars update needed.
# Run `sudo snapshot-dev-state` on the instance before stopping to save state.
dev_state_volume_enabled  = true
dev_state_volume_size_gib = 120
dev_state_volume_type     = "gp3"
dev_state_mount_path      = "/work"
# Automatically snapshot before stopping. Requires ssm:SendCommand + ssm:GetCommandInvocation on the Terraform runner.
dev_state_auto_save       = true
